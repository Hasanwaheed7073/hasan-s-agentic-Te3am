# Engine: by default the team runs on this PC's Claude Code login (your Claude plan), no key needed.
# Only if you later get an Anthropic API key: set ENGINE=api and fill in ANTHROPIC_API_KEY.
ENGINE=claude-code
ANTHROPIC_API_KEY=

# Optional
PORT=4310
# true = run the team's browser invisibly
BROWSER_HEADLESS=false
# Max model calls per message before a team member stops
MAX_STEPS_PER_TURN=60
# Minutes an approval request waits before it counts as denied
APPROVAL_TIMEOUT_MINUTES=30
# Set to false if your API account rejects these beta features
ENABLE_FALLBACKS=true
ENABLE_COMPACTION=true

# Optional email sending for approved emails (otherwise they go to the manual-send queue)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
